{
  "default": "QGIS",
  "fonts": [
    {
      "family": "Doto",
      "google": "Doto:wght@100..900",
      "fallback": "sans-serif"
    },
    {
      "family": "Noto Sans",
      "google": "Noto+Sans:ital,wght@0,300..700;1,300..700",
      "fallback": "sans-serif"
    }
  ],
  "styles": [
    {
      "name": "QGIS",
      "css": {
        "--accent": "#111111",
        "--ink": "#1a1a1a",
        "--ink-dim": "#555555",
        "--ink-faint": "#8a8a8a",
        "--panel-bg": "#ffffff",
        "--panel-line": "#c8c8c8",
        "--space": "#ffffff",
        "--font-title": "'Doto', sans-serif",
        "--font-display": "'Noto Sans', sans-serif",
        "--font-body": "'Noto Sans', sans-serif",
        "--font-label": "'Noto Sans', sans-serif",
        "--font-ui": "'Noto Sans', sans-serif",
        "--weight-title": "500",
